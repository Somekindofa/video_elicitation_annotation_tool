  "comment": {
    "__comment": "Manner adverbs, sequential connectives, instrumental prepositional phrases, and the gerundive construction (en + present participle).",
    "manner_adverbs": [
      "doucement", "lentement", "rapidement", "vite", "vivement",
      "délicatement", "fermement", "légèrement", "fortement",
      "précisément", "soigneusement", "régulièrement",
      "progressivement", "graduellement", "uniformément",
      "parallèlement", "perpendiculairement", "droit", "obliquement",
      "à peine", "juste assez", "suffisamment"
    ],
    "sequential_phrases": [
      "d'abord", "premièrement", "ensuite", "puis", "après ça",
      "enfin", "finalement", "pour commencer", "pour terminer",
      "en premier", "en dernier", "tout d'abord", "par la suite",
      "en même temps", "en parallèle", "simultanément"
    ],
    "instrumental_phrases": [
      "à l'aide de", "au moyen de", "grâce à", "à l'aide du",
      "au moyen du", "avec le", "avec la", "avec les", "avec un", "avec une",
      "à la main", "à deux mains", "avec les doigts", "avec le pouce"
    ],
    "__gerundive_note": "en + VERB[VerbForm=Part] is detected via Matcher, not listed here (open-class).",
    "__instrument_note": "Bare 'avec' is NOT in the list — it is too common as a generic comitative. We require 'avec le/la/les/un/une/des' phrases or explicit tool-introducing phrases."
  },

  "pourquoi": {
    "__comment": "Causal conjunctions, teleological markers (pour+INF, afin de+INF), intentional verbs in matrix position, and goal nouns.",
    "causal_phrases": [
      "parce que", "parce qu'",
      "car",
      "puisque", "puisqu'",
      "du fait que", "du fait de",
      "étant donné que", "étant donné",
      "vu que",
