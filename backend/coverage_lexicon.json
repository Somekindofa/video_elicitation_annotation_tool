  "thresholds": {
    "__comment": "A phase status requires BOTH a minimum rate (hits per 100 tokens) AND a minimum absolute hit count. Rate keeps long rambling transcripts from being rewarded for mere length; absolute floor keeps short vacuous clips from being rewarded for sparsity. Tune empirically once real transcripts are available.",
    "partial_rate": 0.3,
    "partial_min_hits": 2,
    "covered_rate": 1.0,
    "covered_min_hits": 5,
    "plateau_epsilon_hits": 2,
    "__plateau_note": "Plateau fires when the LAST two annotations added fewer than 'plateau_epsilon_hits' hits to each of the three phase aggregates."
  }
}
