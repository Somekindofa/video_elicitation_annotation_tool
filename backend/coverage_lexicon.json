    "__pour_infinitive_note": "Bare 'pour' alone is ambiguous (can be preposition). Detected separately via Matcher as 'pour + VERB' (infinitive).",
    "intentional_verb_lemmas": [
      "vouloir", "chercher", "essayer", "tenter", "viser",
      "falloir", "devoir",
      "éviter", "empêcher", "prévenir",
      "permettre", "obtenir", "arriver",
